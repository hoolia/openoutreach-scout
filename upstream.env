# Pinned OpenOutreach source: the last upstream commit that still carries the in-repo,
# Django-free LinkedIn library `linkedin_cli` (eracle/OpenOutreach, GPL-3.0 at this
# commit; upstream moved to Apache-2.0 on 2026-11-16, after linkedin_cli was removed).
# Later commits consume it as the external package linkedin-agent-cli, which no longer
# resolves, and from 2026-07-02 upstream removed LinkedIn automation entirely.
UPSTREAM_REPO=https://github.com/eracle/OpenOutreach
UPSTREAM_COMMIT=ade7fbdbd5a4595581fabf3cec1e803519a299a6
UPSTREAM_SHA256=773f53922dab5c5db1649a4913c3aed5b4d4dfe92919943c05d67a4081f772ab
# no upstream release exists at this commit; the image carries this as upstream version
UPSTREAM_VERSION=20260604-ade7fbd
